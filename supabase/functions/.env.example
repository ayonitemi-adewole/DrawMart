# Secrets for the Edge Functions. For local `npx supabase functions serve`,
# copy to supabase/functions/.env (git-ignored). For your hosted project:
#   npx supabase secrets set FLW_SECRET_KEY=... FLW_WEBHOOK_HASH=...

# Flutterwave dashboard → Settings → API keys. Use the TEST key while test mode is on.
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Any long random string. Enter the same value as the "Secret hash" in
# Flutterwave dashboard → Settings → Webhooks.
FLW_WEBHOOK_HASH=change-me-to-a-long-random-string
